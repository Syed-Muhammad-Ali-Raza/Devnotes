NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: a shared token for the /api/revalidate endpoint.
# NOTE: this endpoint is called from the browser, so a token sent by clients is
# not a secret — treat it as anti-abuse/rate-limit aid, not as hard auth. Leave
# unset to disable the check (default).
# REVALIDATION_SECRET=changeme
